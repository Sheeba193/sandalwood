{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "build:memory": "set NODE_OPTIONS=--max-old-space-size=4096 && vite build",
        "dev:memory": "set NODE_OPTIONS=--max-old-space-size=4096 && vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@inertiajs/core": "^2.2.18",
