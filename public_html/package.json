        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "lenis": "^1.3.23",
        "lucide-vue-next": "^1.0.0",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
